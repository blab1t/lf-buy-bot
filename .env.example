# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# The server this bot manages.
GUILD_ID=
# Your Discord user ID. Gets pinged for new requests and bypasses the staff check.
OWNER_ID=
# Minimum staff role allowed to review requests and manage tickets.
# Leave blank to fall back to Administrator + OWNER_ID; /setup creates a Staff role
# and fills this in for you if it is empty.
STAFF_ROLE_ID=
# Optional: blabit.dev API key (auto-fills Hypixel stats when a request names an account)
BLABIT_API_KEY=
# Optional: free CoinGecko demo key for higher crypto rate limits
COINGECKO_API_KEY=
